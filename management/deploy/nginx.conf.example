# Include in your Nginx configuration after replacing hostname and TLS paths.
# Keep native hbbs/hbbr ports and their existing configuration unchanged.
limit_req_zone $binary_remote_addr zone=management_login:10m rate=10r/m;
server {
    listen 443 ssl;
    server_name management.example.com;
    ssl_certificate /etc/letsencrypt/live/management.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/management.example.com/privkey.pem;
    client_max_body_size 2m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location = /api/login {
        limit_req zone=management_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:21114;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
    }
    location / {
        proxy_pass http://127.0.0.1:21114;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
